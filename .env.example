# 브라우저에 공개되는 NAVER Maps Client ID만 설정합니다.
# 실제 값은 .env.local에만 두고 커밋하지 않습니다.
# NAVER Cloud 콘솔에 등록해야 하는 Web 서비스 URL(origin):
#   http://localhost:5173   (pnpm dev)
#   http://127.0.0.1:4173   (pnpm preview, Playwright E2E)
VITE_NAVER_MAP_CLIENT_ID=

# 지도 provider: naver | fixture. 비우면 naver입니다.
# fixture는 NAVER SDK 없이 검토용 grid 지도로 동작합니다(테스트·오프라인 검토용).
VITE_MAP_PROVIDER=
